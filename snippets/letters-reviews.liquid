  </ul>
</section>

{% stylesheet %}
  .letters-reviews {
    margin-block-start: var(--padding-2xl);
    width: 100%;
  }

  .letters-reviews__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: var(--padding-md);
  }

  .letters-reviews__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.2;
    color: var(--color-foreground);
  }

  .letters-reviews__subtitle {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-paragraph-small--size, 0.85rem);
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .letters-reviews__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .letters-review {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--padding-lg);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    border-radius: 12px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .letters-review__header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .letters-review__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgb(var(--color-foreground-rgb) / 0.12);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    font-family: var(--font-body--family);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
  }

  .letters-review__who {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .letters-review__author {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.92rem;
    line-height: 1.2;
    color: var(--color-foreground);
  }

  .letters-review__city {
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .letters-review__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    line-height: 1.3;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .letters-review__verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: rgb(var(--color-foreground-rgb) / 0.85);
    font-weight: 600;
  }

  .letters-review__verified svg {
    opacity: 0.9;
  }

  .letters-review__date {
    white-space: nowrap;
  }

  .letters-review__stars {
    margin-inline-start: auto;
    flex-shrink: 0;
    color: var(--color-foreground);
    letter-spacing: 1.5px;
    line-height: 1;
    font-size: 0.95rem;
  }

  .letters-review__text {
    margin: 0;
    font-size: var(--font-paragraph--size);
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.92);
    font-style: italic;
  }

  .letters-review__product {
    margin: auto 0 0;
    padding-top: 10px;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  @media screen and (max-width: 749px) {
    .letters-reviews__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .letters-review__stars {
      font-size: 0.85rem;
    }
  }
{% endstylesheet %}

    <li class="letters-review">
      <div class="letters-review__header">
        <span class="letters-review__avatar" aria-hidden="true">RL</span>
        <div class="letters-review__who">
          <p class="letters-review__author"><strong>Ricardo L.</strong> <span class="letters-review__city">· Bucaramanga</span></p>
